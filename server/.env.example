# ============================================
# Environment Variables untuk Distributed Chat
# ============================================

# Port server (setiap server harus berbeda)
# Server 1: PORT=3000
# Server 2: PORT=3001
PORT=3000

# Redis connection URL
# Lokal: redis://localhost:6379
# Railway: redis://default:password@host:port
REDIS_URL=redis://localhost:6379

# Server ID (untuk identifikasi di log)
SERVER_ID=server-1
